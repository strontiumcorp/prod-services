REDIS_IMAGE=redis:8.8.0-alpine
REDIS_BIND_ADDRESS=127.0.0.1

REDIS_CACHE_CONTAINER_NAME=redis-cache
REDIS_SESSION_CONTAINER_NAME=redis-session
REDIS_QUEUE_CONTAINER_NAME=redis-queue
REDIS_WS_CONTAINER_NAME=redis-ws

REDIS_CACHE_HOST_PORT=6379
REDIS_SESSION_HOST_PORT=6380
REDIS_QUEUE_HOST_PORT=6381
REDIS_WS_HOST_PORT=6382

REDIS_CACHE_DATA_DIR=./data/cache
REDIS_SESSION_DATA_DIR=./data/session
REDIS_QUEUE_DATA_DIR=./data/queue
REDIS_WS_DATA_DIR=./data/ws

REDIS_PIDS_LIMIT=4096
REDIS_STOP_GRACE_PERIOD=30s
REDIS_LOG_MAX_SIZE=100m
REDIS_LOG_MAX_FILE=5

# Generator defaults. Leave commented to tune from host resources.
# REDIS_MEMORY_MB=16384
# REDIS_CPU_CORES=8
# REDIS_HOST_MEMORY_RESERVE_PERCENT=10
# REDIS_MEMORY_BUDGET_PERCENT=25
# REDIS_CACHE_MAXMEMORY_MB=700
# REDIS_SESSION_MAXMEMORY_MB=300
# REDIS_QUEUE_MAXMEMORY_MB=1200
# REDIS_WS_MAXMEMORY_MB=128

REDIS_CACHE_PASSWORD=
REDIS_SESSION_PASSWORD=
REDIS_QUEUE_PASSWORD=
REDIS_WS_PASSWORD=
