# Generated by scripts/generate-postgres-config.sh on {{GENERATED_AT}}
# Host resources detected: {{HOST_MEMORY_MB}}MB RAM, {{CPU_CORES}} CPU cores.
# Host/Docker reserve: {{HOST_MEMORY_RESERVE_PERCENT}}% ({{HOST_MEMORY_RESERVED_MB}}MB).
# Postgres tuning memory: {{POSTGRES_TUNING_MEMORY_MB}}MB.
# To override detection, set POSTGRES_MEMORY_MB and/or POSTGRES_CPU_CORES in .env.

# Listen/basics
listen_addresses = '*'
port = 5432
max_connections = {{MAX_CONNECTIONS}}

# Memory
shared_buffers = {{SHARED_BUFFERS}}
effective_cache_size = {{EFFECTIVE_CACHE_SIZE}}
work_mem = {{WORK_MEM}}
maintenance_work_mem = {{MAINTENANCE_WORK_MEM}}

# WAL & checkpoints
wal_level = replica
wal_compression = on
max_wal_size = {{MAX_WAL_SIZE}}
min_wal_size = {{MIN_WAL_SIZE}}
checkpoint_timeout = 15min
checkpoint_completion_target = 0.9
synchronous_commit = on

# Planner / SSD assumptions
random_page_cost = 1.1
effective_io_concurrency = 200

# Worker tuning
max_worker_processes = {{MAX_WORKER_PROCESSES}}
max_parallel_workers = {{MAX_PARALLEL_WORKERS}}
max_parallel_workers_per_gather = {{MAX_PARALLEL_WORKERS_PER_GATHER}}

# Extensions / stats
shared_preload_libraries = 'pg_stat_statements'
pg_stat_statements.max = 10000
pg_stat_statements.track = all
track_io_timing = on

# Autovacuum
autovacuum = on
autovacuum_max_workers = {{AUTOVACUUM_MAX_WORKERS}}
autovacuum_naptime = 10s
autovacuum_vacuum_cost_limit = 2000
vacuum_cost_limit = 2000

# Logging to container stdout/stderr
log_destination = 'stderr'
logging_collector = off
log_line_prefix = '%m [%p] %u@%d '
log_min_duration_statement = {{LOG_MIN_DURATION_STATEMENT}}

# Locale/encoding
lc_messages = 'C'
lc_monetary = 'C'
lc_numeric  = 'C'
lc_time     = 'C'
